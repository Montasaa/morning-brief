# Morning Brief web app. Copy to .env.local for local runs; never commit real values.

# SQLite file (relative to web/). Default: data/brief.db
DATABASE_PATH=data/brief.db

# URL path the app is served under on the existing domain. Read at build time. Default: /brief
BASE_PATH=/brief

# Bearer token the gathering side sends to POST /api/editions and GET /api/gathering-list.
# Empty or unset refuses every pipeline call.
INGEST_TOKEN=

# "fake" swaps every outside service (Claude, Resend, Open-Meteo, Aladhan, Web Push)
# for the in-process fakes. Only for the e2e server and local demos.
OUTSIDE_SERVICES=

# Secrets for the outside services, read by their adapters when connected (later tickets):
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
