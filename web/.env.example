# Morning Brief web app. Copy to .env.local for local runs; never commit real values.

# SQLite file (relative to web/). Default: data/brief.db
DATABASE_PATH=data/brief.db

# URL path the app is served under on the existing domain. Read at build time. Default: /brief
BASE_PATH=/brief

# Bearer token the gathering side sends to POST /api/editions and GET /api/gathering-list.
# Empty or unset refuses every pipeline call.
INGEST_TOKEN=

# The Owner, created at setup (first start) if there is no Owner yet. Signs in by magic link.
OWNER_EMAIL=

# The public origin magic links point at, e.g. https://example.com (no path; BASE_PATH is added).
# Set it in production: without it, links use the request's Host header (fine for local runs only).
# An https origin also makes the session cookie Secure.
PUBLIC_ORIGIN=

# Sender for sign-in and Invite emails, on a domain verified in Resend.
# e.g. Morning Brief <brief@example.com>
EMAIL_FROM=

# "fake" swaps every outside service (Claude, Resend, Open-Meteo, Aladhan, Web Push)
# for the in-process fakes. Only for the e2e server and local demos.
OUTSIDE_SERVICES=

# With OUTSIDE_SERVICES=fake, also append every email the fake Resend "sends" to this
# file as JSON lines (the e2e server uses it to open magic links). Local only.
FAKE_OUTBOX_FILE=

# Resend API key for sign-in and Invite emails (with EMAIL_FROM). Secret.
RESEND_API_KEY=

# Claude API key for Ask (ticket 16) and the other Claude features. Secret.
# Unset means Claude is not connected and Ask answers with an error.
ANTHROPIC_API_KEY=
# Or an Anthropic-compatible endpoint instead (wins when both of these are set): OpenCode Go is
# https://opencode.ai/inference/go/anthropic with a Go API key (secret). It is a plain Messages API
# call, so Ask loses web search and citations. ASK_MODEL defaults to claude-haiku-5-5 there.
LLM_BASE_URL=
LLM_API_KEY=
ASK_MODEL=

# Web Push (ticket 18): the VAPID key pair (raw P-256, base64url) and a contact for the push services.
# All three set connects push; otherwise the Me tab says notifications are not set up. The private key is secret.
# Make a pair once (and keep it: changing it unsubscribes every device):
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# e.g. mailto:you@example.com
VAPID_SUBJECT=
