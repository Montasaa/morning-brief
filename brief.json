  <style>
    :root {
      --accent: #58a6ff;
      --badge-bg: rgba(88, 166, 255, 0.1);
      --badge-color: #58a6ff;
      --badge-border: rgba(88, 166, 255, 0.2);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0d1117;
      color: #c9d1d9;
      font-family: "Figtree", system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.5rem;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--accent);
      z-index: 10;
    }
    main { width: 100%; max-width: 680px; }
    .badge {
      display: inline-block;
      padding: 0.2rem 0.65rem;
      border-radius: 100px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1rem;
      background: var(--badge-bg);
      color: var(--badge-color);
      border: 1px solid var(--badge-border);
    }
    h1 { font-size: 1.75rem; font-weight: 700; color: #e6edf3; line-height: 1.3; margin-bottom: 0.5rem; }
    .host { color: #f0883e; }
    .desc { font-size: 0.938rem; color: #8b949e; margin-bottom: 2rem; max-width: 540px; }
    .status-row {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 2rem 1rem;
      background: #161b22;
      border: 1px solid #21262d;
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
    .node { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; min-width: 90px; }
    .node-icon { position: relative; width: 48px; height: 48px; }
    .node-icon svg.device { width: 48px; height: 48px; }
    .status-dot {
      position: absolute;
      bottom: -3px; right: -3px;
      width: 18px; height: 18px;
      border-radius: 50%;
      border: 2.5px solid #161b22;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dot-ok { background: #238636; }
    .dot-info { background: #1f6feb; }
    .status-dot svg { width: 10px; height: 10px; }
    .node-name { font-size: 0.7rem; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em; }
    .node-status { font-size: 0.75rem; font-weight: 500; }
    .s-ok { color: #3fb950; }
    .s-info { color: #58a6ff; }
    .connector { flex-shrink: 0; width: 56px; margin-top: 22px; border-top: 2px dashed #30363d; }
    .divider { border: none; border-top: 1px solid #21262d; margin: 0 0 1.5rem; }
    .challenge { display: flex; justify-content: center; padding: 1.5rem 0; margin-bottom: 1.5rem; }
    .help-text { font-size: 0.875rem; color: #8b949e; margin-bottom: 1.5rem; }
    a { color: #58a6ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    footer {
      padding-top: 1rem;
      border-top: 1px solid #21262d;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      font-size: 0.688rem;
      color: #484f58;
    }
    @media (max-width: 600px) {
      body { padding: 1.5rem 1rem; }
      h1 { font-size: 1.35rem; }
      .desc { font-size: 0.875rem; }
      .status-row { padding: 1.5rem 0.5rem; }
      .connector { width: 28px; }
      .node { min-width: 72px; }
      .node-icon, .node-icon svg.device { width: 40px; height: 40px; }
      .status-dot { width: 16px; height: 16px; border-width: 2px; }
      .status-dot svg { width: 8px; height: 8px; }
    }
  </style>
